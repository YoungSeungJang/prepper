# Web app public env
# For local Next.js development, put these values in apps/web/.env or apps/web/.env.local.
# These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only env
# Do not expose these through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
YOUTUBE_API_KEY=

# Server-only price data env
# Planned for Supabase Edge Functions / backend jobs.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
