# Express API env
# Copy to apps/api/.env for local development.
PORT=4000

# Supabase Auth verification.
# The API also accepts SUPABASE_URL/SUPABASE_ANON_KEY, but deployment uses
# the shared NEXT_PUBLIC_* names so web and api can read the same SSM values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recipe import parser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
YOUTUBE_API_KEY=
