{
  "expo": {
    "name": "Prepper",
    "slug": "prepper-mobile",
    "scheme": "prepper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.prepper.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.prepper.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#fffaf3",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d13b8f12-c3fb-457a-9909-db583b32692e"
      }
    }
  }
}
