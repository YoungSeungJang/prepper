# Next.js loads this file from apps/web.
# Copy to apps/web/.env or apps/web/.env.local and fill in your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only recipe import parser env.
# Do not prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
YOUTUBE_API_KEY=
